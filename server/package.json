    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.8.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "officeparser": "^8.0.0",
    "openai": "^6.49.0",
    "pdf-img-convert": "^2.0.0",
    "pdf-parse-new": "^2.1.0",
    "pdfkit": "^0.20.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
